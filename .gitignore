.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store
.env
.env.*
!.env.example

# Downloaded OHLCV history: keep the folder, ignore the data.
data/candles/*
!data/candles/.gitkeep

# Rust build output.
rust/*/target/

# Logs: the debug log and the trading log (and its Parquet archive). They live
# under ~/.local/share by default; these keep them out if pointed into the repo.
*.log
events.jsonl
events.parquet

tests/golden/*.actual.png
